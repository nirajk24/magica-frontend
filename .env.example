NEXT_PUBLIC_API_URL=http://localhost:3001

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# End-to-end tests only. A Clerk test-mode account: any address carrying the `+clerk_test`
# subaddress never receives mail, so it is safe to automate against. Needed by `pnpm e2e:live`,
# which signs in and sends ONE real turn — `pnpm e2e` needs neither.
E2E_CLERK_EMAIL=your_email+clerk_test@example.com
E2E_CLERK_PASSWORD=
